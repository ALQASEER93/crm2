#-------------------------------------------------
# Application Configuration
#-------------------------------------------------
# The port the application will run on.
PORT=5000
# The application environment. Can be 'development', 'production', or 'test'.
NODE_ENV=development

#-------------------------------------------------
# Database Configuration (PostgreSQL)
#-------------------------------------------------
# Hostname of the database server.
DB_HOST=localhost
# Port of the database server.
DB_PORT=5432
# Username for database connection.
DB_USER=postgres
# Password for database connection.
DB_PASSWORD=secret
# Name of the database.
DB_NAME=dopamine_crm

#-------------------------------------------------
# Database Migrations (node-pg-migrate)
#-------------------------------------------------
# Full database connection URL. Used by node-pg-migrate.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:secret@localhost:5432/dopamine_crm

#-------------------------------------------------
# JSON Web Token (JWT) Authentication
#-------------------------------------------------
# A strong, secret key for signing JWTs.
JWT_SECRET=your-super-secret-jwt-key
# Expiration time for access tokens (e.g., '1h', '1d', '7d').
JWT_EXPIRES_IN=1d

#-------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
#-------------------------------------------------
# The origin(s) allowed to access the API, separated by commas.
# Use '*' for development, but specify your frontend URL in production.
CORS_ORIGIN=http://localhost:5173
